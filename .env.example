# ── Perforce (하드 디펜던시) ──────────────────────────────
P4PORT=ssl:perforce.company.com:1666
P4USER=gigantic-agent
P4DEPOT=//project/main/...

# ── Dashboard ────────────────────────────────────────────
DASHBOARD_PORT=3000
# 설정하면 대시보드에 로그인이 생깁니다 (미설정 시 개방)
# DASHBOARD_PASSWORD=change-me

# ── Database ─────────────────────────────────────────────
# 미설정        → 인메모리 mock 엔진 (재시작 시 시드로 초기화)
# pglite://경로 → 내장 Postgres(PGlite) — 개발용 영속화, 서버 불필요
# postgres://…  → PostgreSQL 16 (운영 — docker compose가 자동 주입)
# DATABASE_URL=pglite://.data/gigantic
# DATABASE_URL=postgres://gigantic:gigantic@localhost:5432/gigantic

# ── Orchestrator ─────────────────────────────────────────
ORCHESTRATOR_PORT=4000
