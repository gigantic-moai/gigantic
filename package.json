{
  "name": "gigantic",
  "version": "0.0.1",
  "private": true,
  "description": "Gigantic — Unreal Engine agentic development platform",
  "scripts": {
    "dev": "pnpm --filter @gigantic/dashboard dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "db:generate": "pnpm --filter @gigantic/dashboard db:generate",
    "db:migrate": "pnpm --filter @gigantic/dashboard db:migrate",
    "db:push": "pnpm --filter @gigantic/dashboard db:push"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
